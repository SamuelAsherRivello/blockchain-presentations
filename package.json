{
  "name": "blockchain-presentations",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config comparison.vite.config.mjs --port 3032 --strictPort",
    "dev:comparison": "vite --config comparison.vite.config.mjs --port 3032 --strictPort",
    "predev:stable-preview": "node presentations/scripts/patch-slidev-editor-autosave.mjs",
    "dev:stable-preview": "node presentations/scripts/slidev-live-preview.mjs start --duration-hours 12",
    "preview:status": "node presentations/scripts/slidev-live-preview.mjs status",
    "verify:live-preview:landing": "node presentations/scripts/verify-live-preview-landing.mjs",
    "verify:live-preview:proxy": "node --test presentations/scripts/test-live-preview-proxy.mjs",
    "verify:live-preview:fast": "node --test presentations/scripts/test-live-preview-manifest.mjs presentations/scripts/test-live-preview-policy.mjs presentations/scripts/test-live-preview-readiness.mjs presentations/scripts/test-live-preview-coherence.mjs presentations/scripts/test-live-preview-diagnostics.mjs && node presentations/scripts/verify-live-preview.mjs --profile fast",
    "verify:live-preview": "node presentations/scripts/verify-live-preview.mjs --profile integration",
    "verify:live-preview:soak": "node presentations/scripts/slidev-live-preview.mjs soak --duration-hours 12",
    "dev:seriph": "slidev presentations/content/decks/slides.md --theme seriph --port 3042 --base /slidev/seriph/",
    "dev:apple-basic": "slidev presentations/content/decks/slides.md --theme apple-basic --port 3043 --base /slidev/apple-basic/",
    "dev:dracula": "slidev presentations/content/decks/slides.md --theme dracula --port 3044 --base /slidev/dracula/",
    "dev:template": "slidev presentations/content/templates/template-deck.md --theme default --port 3045 --base /slidev/template/",
    "dev:modrian-template-1": "slidev presentations/content/templates/template-deck.md --theme ./presentations/themes/mondrian-classic --port 3046 --base /slidev/modrian-template-1/",
    "dev:modrian-template-2": "slidev presentations/content/templates/modrian-template-2.md --theme ./presentations/themes/mondrian-night --port 3047 --base /slidev/modrian-template-2/",
    "dev:modrian-template": "slidev presentations/content/templates/modrian-template.md --theme ./presentations/themes/mondrian --port 3049 --base /slidev/modrian-template/",
    "predev:modrian-template": "npm run sync:layout-mappings",
    "dev:modrian-template-3": "slidev presentations/content/templates/template-deck.md --theme ./presentations/themes/mondrian-signal --port 3048 --base /slidev/modrian-template-3/",
    "dev:blockchain-for-game-designers": "slidev presentations/content/decks/blockchain-for-game-designers.md --theme ./presentations/themes/mondrian --port 3051 --base /slidev/blockchain-for-game-designers/",
    "predev:blockchain-for-game-designers": "npm run sync:layout-mappings",
    "dev:blockchain-for-game-developers": "slidev presentations/content/decks/blockchain-for-game-developers.md --theme ./presentations/themes/mondrian --port 3057 --base /slidev/blockchain-for-game-developers/",
    "predev:blockchain-for-game-developers": "npm run sync:layout-mappings",
    "dev:bitcoin-for-games": "slidev presentations/content/decks/bitcoin-for-game-development.md --theme ./presentations/themes/mondrian --port 3056 --base /slidev/bitcoin-for-games/",
    "predev:bitcoin-for-games": "npm run sync:layout-mappings",
    "dev:tease-subdeck": "slidev presentations/content/decks/tease-subdeck.md --theme ./presentations/themes/mondrian --port 3053 --base /slidev/tease-subdeck/",
    "predev:tease-subdeck": "npm run sync:layout-mappings",
    "dev:games-subdeck": "slidev presentations/content/decks/games-subdeck.md --theme ./presentations/themes/mondrian --port 3055 --base /slidev/games-subdeck/",
    "predev:games-subdeck": "npm run sync:layout-mappings",
    "dev:outro": "slidev presentations/content/decks/outro.md --theme ./presentations/themes/mondrian --port 3052 --base /slidev/outro/",
    "dev:live-preview-fixture": "slidev presentations/fixtures/live-preview-fixture.md --theme default --port 3054 --base /slidev/live-preview-fixture/",
    "predev:outro": "npm run sync:layout-mappings",
    "build": "npm run build:modrian-template",
    "build:modrian-template": "slidev build presentations/content/templates/modrian-template.md --theme ./presentations/themes/mondrian --out ../../../dist/modrian-template",
    "prebuild:modrian-template": "npm run sync:layout-mappings",
    "build:blockchain-for-game-designers": "slidev build presentations/content/decks/blockchain-for-game-designers.md --theme ./presentations/themes/mondrian --out ../../../dist/blockchain-for-game-designers",
    "prebuild:blockchain-for-game-designers": "npm run sync:layout-mappings",
    "build:blockchain-for-game-developers": "slidev build presentations/content/decks/blockchain-for-game-developers.md --theme ./presentations/themes/mondrian --out ../../../dist/blockchain-for-game-developers",
    "prebuild:blockchain-for-game-developers": "npm run sync:layout-mappings",
    "build:bitcoin-for-games": "slidev build presentations/content/decks/bitcoin-for-game-development.md --theme ./presentations/themes/mondrian --out ../../../dist/bitcoin-for-games",
    "prebuild:bitcoin-for-games": "npm run sync:layout-mappings",
    "build:tease-subdeck": "slidev build presentations/content/decks/tease-subdeck.md --theme ./presentations/themes/mondrian --out ../../../dist/tease-subdeck",
    "prebuild:tease-subdeck": "npm run sync:layout-mappings",
    "build:games-subdeck": "slidev build presentations/content/decks/games-subdeck.md --theme ./presentations/themes/mondrian --out ../../../dist/games-subdeck",
    "prebuild:games-subdeck": "npm run sync:layout-mappings",
    "build:outro": "slidev build presentations/content/decks/outro.md --theme ./presentations/themes/mondrian --out ../../../dist/outro",
    "prebuild:outro": "npm run sync:layout-mappings",
    "prebuild:decks": "npm run sync:layout-mappings",
    "build:decks": "npm run verify:bullet-style && npm run build:modrian-template && npm run build:blockchain-for-game-designers && npm run build:blockchain-for-game-developers && npm run build:bitcoin-for-games && npm run build:tease-subdeck && npm run build:games-subdeck && npm run build:outro",
    "prebuild:public": "npm run sync:layout-mappings",
    "build:public": "node presentations/scripts/build-public-decks.mjs",
    "sync:layout-mappings": "node presentations/scripts/sync-layout-mappings.mjs && node presentations/scripts/verify-layout-contract.mjs",
    "verify:layout-mappings:self-test": "node presentations/scripts/sync-layout-mappings.mjs --self-test",
    "verify:layout-contract": "node presentations/scripts/verify-layout-contract.mjs",
    "verify:bullet-style": "node presentations/scripts/verify-bullet-style.mjs",
    "verify:layout-contract:self-test": "node presentations/scripts/verify-layout-contract.mjs --self-test",
    "verify:rendered-layouts": "node presentations/scripts/verify-rendered-layouts.mjs",
    "export": "slidev export presentations/content/templates/modrian-template.md --theme ./presentations/themes/mondrian"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-apple-basic": "^0.25.1",
    "@slidev/theme-bricks": "^0.25.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "playwright-chromium": "^1.63.0",
    "slidev-theme-dracula": "^0.2.5"
  }
}
